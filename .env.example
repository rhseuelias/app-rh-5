NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Só usada no servidor, para o formulário público de pré-cadastro do
# candidato (sem login). NUNCA prefixe com NEXT_PUBLIC_ — ela ignora
# as regras de segurança do banco, não pode ir pro navegador.
# Pegue em Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Código secreto do link da diretoria (/diretoria/CODIGO). Use de 32 a 64 letras/números.
# Para trocar o link, troque este código (o antigo deixa de funcionar).
DIRETORIA_TOKEN=troque-por-um-codigo-longo-e-secreto-de-48-caracteres
